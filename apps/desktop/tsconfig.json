{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "out",
    "baseUrl": ".",
    "paths": {
      "@nexus/shared": ["../../packages/shared/src"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "electron.vite.config.ts"]
}
